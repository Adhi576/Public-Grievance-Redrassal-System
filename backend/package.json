{
  "name": "pgrs-backend",
  "version": "1.0.0",
  "description": "Public Grievance Redressal System - Backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "npx sequelize-cli db:migrate --config config.json --migrations-path src/migrations",
    "migrate:undo": "npx sequelize-cli db:migrate:undo:all --config config.json --migrations-path src/migrations",
    "seed": "npx sequelize-cli db:seed:all --config config.json --seeders-path src/seeders",
    "seed:undo": "npx sequelize-cli db:seed:undo:all --config config.json --seeders-path src/seeders",
    "test": "jest --runInBand --forceExit"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testTimeout": 30000
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "mysql2": "^3.24.4",
    "node-cron": "^4.6.0",
    "pdfkit": "^0.20.2",
    "sequelize": "^6.37.8",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "jest": "^30.5.1",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
