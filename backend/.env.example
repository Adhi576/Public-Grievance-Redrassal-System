# Server
PORT=5000
NODE_ENV=development

# Database (Supabase PostgreSQL)
# Option A: Direct or Pooler Connection URI (Recommended for Supabase)
DATABASE_URL=postgresql://postgres.[your-project-ref]:[your-password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Option B: Individual Connection Parameters
DB_DIALECT=postgres
DB_HOST=aws-0-[region].pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.[your-project-ref]
DB_PASSWORD=your_supabase_db_password_here
DB_SSL=true

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=24h

# File Storage
UPLOAD_PATH=./uploads

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
